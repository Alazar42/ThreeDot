{
  "name": "threedot",
  "version": "0.1.0",
  "description": "A Godot-inspired framework for Three.js — structured scene trees, lifecycle management, signals, input, UI, and more.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./jsx": {
      "import": {
        "types": "./dist/jsx.d.ts",
        "default": "./dist/jsx.js"
      },
      "require": {
        "types": "./dist/jsx.d.cts",
        "default": "./dist/jsx.cjs"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "workspaces": [
    "api_docs"
  ],
  "scripts": {
    "dev": "npm --workspace=api_docs run dev",
    "docs:dev": "npm --workspace=api_docs run dev",
    "docs:build": "npm --workspace=api_docs run build",
    "docs:preview": "npm --workspace=api_docs run preview",
    "build": "tsup",
    "build:check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ --ext .ts,.tsx",
    "format": "prettier --write 'src/**/*.ts' 'api_docs/**/*.ts' 'api_docs/**/*.tsx'",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "npm run build && npm run typecheck && npm run test"
  },
  "keywords": [
    "threejs",
    "three.js",
    "godot",
    "game-engine",
    "scene-tree",
    "node-system",
    "3d",
    "2d",
    "webgl",
    "typescript",
    "game-framework",
    "signals",
    "ecs"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Alazar42/ThreeDot.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@dimforge/rapier2d-compat": "^0.21.0",
    "@dimforge/rapier3d-compat": "^0.21.0",
    "three": "^0.186.1",
    "troika-three-text": "^0.52.5"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^10.13.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
